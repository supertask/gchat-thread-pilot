# .env.example — 全て自分の環境の値に置き換えること

# --- Chat アプリ基本設定（Hermes Agent 側の既存キー） ---
GOOGLE_CHAT_PROJECT_ID=your-gcp-project
GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/your-gcp-project/subscriptions/your-subscription
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=/secure/path/sa-key.json
GOOGLE_CHAT_ALLOWED_USERS=you@example.com
GOOGLE_CHAT_ALLOW_ALL_USERS=false
GOOGLE_CHAT_IMPERSONATE_USER=delegated-user@example.com

# --- スレッド読み取りパイロットのバインディング ---
GCHAT_PILOT_SPACE=spaces/XXXXXXXXXX
GCHAT_PILOT_BOT_USER=users/XXXXXXXXXX
GCHAT_PILOT_APP_SA=your-bot-sa@your-gcp-project.iam.gserviceaccount.com
